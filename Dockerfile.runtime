## Runtime-only Docker image for mg-asistentes
## Pre-built locally: Next.js standalone, SPA, db migrations
## No build steps - just copy artifacts

FROM node:24-slim AS runtime

WORKDIR /app

# Copy pre-built Next.js standalone output (includes traced node_modules)
COPY .next/standalone ./

# Copy static assets (not included in standalone tracing)
COPY .next/static ./.next/static

# Copy SPA assets (Vite build output)
COPY public/_spa ./public/_spa

# Copy database migrations
COPY packages/database/migrations ./migrations
COPY scripts/migrateServerDB/docker.cjs ./docker.cjs
COPY scripts/migrateServerDB/errorHint.js ./errorHint.js

# Copy server launcher and shared scripts
COPY scripts/serverLauncher/startServer.js ./startServer.js
COPY scripts/_shared ./scripts/_shared

# Install runtime deps needed by migration scripts (pg, drizzle-orm)
# Also install @napi-rs/canvas native binaries for pdfjs-dist 5.x DOMMatrix (PDF text extraction)
# Architecture-aware: installs the correct canvas package for x64 or arm64
RUN npm init -y --silent && \
if [ "$(uname -m)" = "aarch64" ]; then \
  npm install pg drizzle-orm sharp @napi-rs/canvas-linux-arm64-gnu --save --silent; \
else \
  npm install pg drizzle-orm sharp @napi-rs/canvas-linux-x64-gnu --save --silent; \
fi

# Runtime environment
ENV NODE_ENV="production" \
    NODE_OPTIONS="--dns-result-order=ipv4first --use-openssl-ca" \
    NODE_EXTRA_CA_CERTS="" \
    NODE_TLS_REJECT_UNAUTHORIZED="" \
    SSL_CERT_FILE="" \
    HOSTNAME="0.0.0.0" \
    PORT="3210"

# Make the middleware rewrite through local as default
ENV MIDDLEWARE_REWRITE_THROUGH_LOCAL="1"

# General Variables
ENV APP_URL="" \
    API_KEY_SELECT_MODE="" \
    DEFAULT_AGENT_CONFIG="" \
    SYSTEM_AGENT="" \
    FEATURE_FLAGS="" \
    PROXY_URL=""

# Database
ENV KEY_VAULTS_SECRET="" \
    DATABASE_DRIVER="node" \
    DATABASE_URL=""

# Better Auth
ENV AUTH_SECRET="" \
    AUTH_SSO_PROVIDERS="" \
    AUTH_ALLOWED_EMAILS="" \
    AUTH_TRUSTED_ORIGINS="" \
    AUTH_DISABLE_EMAIL_PASSWORD="" \
    AUTH_EMAIL_VERIFICATION="" \
    AUTH_ENABLE_MAGIC_LINK="" \
    AUTH_GOOGLE_ID="" \
    AUTH_GOOGLE_SECRET="" \
    AUTH_GITHUB_ID="" \
    AUTH_GITHUB_SECRET="" \
    AUTH_MICROSOFT_ID="" \
    AUTH_MICROSOFT_SECRET="" \
    AUTH_MICROSOFT_AUTHORITY_URL="" \
    AUTH_MICROSOFT_TENANT_ID=""

# Redis
ENV REDIS_URL="" \
    REDIS_PREFIX="" \
    REDIS_TLS=""

# Email
ENV EMAIL_SERVICE_PROVIDER="" \
    SMTP_HOST="" \
    SMTP_PORT="" \
    SMTP_SECURE="" \
    SMTP_USER="" \
    SMTP_PASS="" \
    SMTP_FROM="" \
    RESEND_API_KEY="" \
    RESEND_FROM=""

# S3
ENV NEXT_PUBLIC_S3_DOMAIN="" \
    S3_PUBLIC_DOMAIN="" \
    S3_ACCESS_KEY_ID="" \
    S3_BUCKET="" \
    S3_ENDPOINT="" \
    S3_SECRET_ACCESS_KEY="" \
    S3_ENABLE_PATH_STYLE="" \
    S3_SET_ACL=""

# All model provider env vars (same as original Dockerfile)
ENV AI21_API_KEY="" AI21_MODEL_LIST="" \
    AI360_API_KEY="" AI360_MODEL_LIST="" \
    AIHUBMIX_API_KEY="" AIHUBMIX_MODEL_LIST="" \
    ANTHROPIC_API_KEY="" ANTHROPIC_MODEL_LIST="" ANTHROPIC_PROXY_URL="" \
    ENABLED_AWS_BEDROCK="" AWS_ACCESS_KEY_ID="" AWS_SECRET_ACCESS_KEY="" AWS_REGION="" AWS_BEDROCK_MODEL_LIST="" \
    AZURE_API_KEY="" AZURE_API_VERSION="" AZURE_ENDPOINT="" AZURE_MODEL_LIST="" \
    BAICHUAN_API_KEY="" BAICHUAN_MODEL_LIST="" \
    CLOUDFLARE_API_KEY="" CLOUDFLARE_BASE_URL_OR_ACCOUNT_ID="" CLOUDFLARE_MODEL_LIST="" \
    COHERE_API_KEY="" COHERE_MODEL_LIST="" COHERE_PROXY_URL="" \
    ENABLED_COMFYUI="" COMFYUI_BASE_URL="" COMFYUI_AUTH_TYPE="" \
    COMFYUI_API_KEY="" COMFYUI_USERNAME="" COMFYUI_PASSWORD="" COMFYUI_CUSTOM_HEADERS="" \
    DEEPSEEK_API_KEY="" DEEPSEEK_MODEL_LIST="" \
    FIREWORKSAI_API_KEY="" FIREWORKSAI_MODEL_LIST="" \
    GITEE_AI_API_KEY="" GITEE_AI_MODEL_LIST="" \
    GITHUB_TOKEN="" GITHUB_MODEL_LIST="" \
    GOOGLE_API_KEY="" GOOGLE_MODEL_LIST="" GOOGLE_PROXY_URL="" \
    VERTEXAI_CREDENTIALS="" VERTEXAI_PROJECT="" VERTEXAI_LOCATION="" VERTEXAI_MODEL_LIST="" \
    GROQ_API_KEY="" GROQ_MODEL_LIST="" GROQ_PROXY_URL="" \
    HIGRESS_API_KEY="" HIGRESS_MODEL_LIST="" HIGRESS_PROXY_URL="" \
    HUGGINGFACE_API_KEY="" HUGGINGFACE_MODEL_LIST="" HUGGINGFACE_PROXY_URL="" \
    HUNYUAN_API_KEY="" HUNYUAN_MODEL_LIST="" \
    INTERNLM_API_KEY="" INTERNLM_MODEL_LIST="" \
    JINA_API_KEY="" JINA_MODEL_LIST="" JINA_PROXY_URL="" \
    MINIMAX_API_KEY="" MINIMAX_MODEL_LIST="" \
    MISTRAL_API_KEY="" MISTRAL_MODEL_LIST="" \
    MODELSCOPE_API_KEY="" MODELSCOPE_MODEL_LIST="" MODELSCOPE_PROXY_URL="" \
    MOONSHOT_API_KEY="" MOONSHOT_MODEL_LIST="" MOONSHOT_PROXY_URL="" \
    NEBIUS_API_KEY="" NEBIUS_MODEL_LIST="" \
    NEWAPI_API_KEY="" NEWAPI_PROXY_URL="" \
    NOVITA_API_KEY="" NOVITA_MODEL_LIST="" \
    NVIDIA_API_KEY="" NVIDIA_MODEL_LIST="" NVIDIA_PROXY_URL="" \
    ENABLED_OLLAMA="" OLLAMA_MODEL_LIST="" OLLAMA_PROXY_URL="" \
    ENABLED_OPENAI="" OPENAI_API_KEY="" OPENAI_MODEL_LIST="" OPENAI_PROXY_URL="" \
    OPENROUTER_API_KEY="" OPENROUTER_MODEL_LIST="" \
    PERPLEXITY_API_KEY="" PERPLEXITY_MODEL_LIST="" PERPLEXITY_PROXY_URL="" \
    PPIO_API_KEY="" PPIO_MODEL_LIST="" \
    QINIU_API_KEY="" QINIU_MODEL_LIST="" QINIU_PROXY_URL="" \
    QWEN_API_KEY="" QWEN_MODEL_LIST="" QWEN_PROXY_URL="" \
    SAMBANOVA_API_KEY="" SAMBANOVA_MODEL_LIST="" \
    SEARCH1API_API_KEY="" SEARCH1API_MODEL_LIST="" \
    SENSENOVA_API_KEY="" SENSENOVA_MODEL_LIST="" \
    SILICONCLOUD_API_KEY="" SILICONCLOUD_MODEL_LIST="" SILICONCLOUD_PROXY_URL="" \
    SPARK_API_KEY="" SPARK_MODEL_LIST="" SPARK_PROXY_URL="" SPARK_SEARCH_MODE="" \
    STEPFUN_API_KEY="" STEPFUN_MODEL_LIST="" \
    TAICHU_API_KEY="" TAICHU_MODEL_LIST="" \
    TOGETHERAI_API_KEY="" TOGETHERAI_MODEL_LIST="" \
    UPSTAGE_API_KEY="" UPSTAGE_MODEL_LIST="" \
    V0_API_KEY="" V0_MODEL_LIST="" \
    VLLM_API_KEY="" VLLM_MODEL_LIST="" VLLM_PROXY_URL="" \
    WENXIN_API_KEY="" WENXIN_MODEL_LIST="" \
    XAI_API_KEY="" XAI_MODEL_LIST="" XAI_PROXY_URL="" \
    XINFERENCE_API_KEY="" XINFERENCE_MODEL_LIST="" XINFERENCE_PROXY_URL="" \
    ZEROONE_API_KEY="" ZEROONE_MODEL_LIST="" \
    ZHIPU_API_KEY="" ZHIPU_MODEL_LIST="" \
    TENCENT_CLOUD_API_KEY="" TENCENT_CLOUD_MODEL_LIST="" \
    INFINIAI_API_KEY="" INFINIAI_MODEL_LIST="" \
    AI302_API_KEY="" AI302_MODEL_LIST="" \
    ENABLED_FAL="" FAL_API_KEY="" FAL_MODEL_LIST="" \
    BFL_API_KEY="" BFL_MODEL_LIST="" \
    VERCELAIGATEWAY_API_KEY="" VERCELAIGATEWAY_MODEL_LIST="" \
    CEREBRAS_API_KEY="" CEREBRAS_MODEL_LIST=""

USER node
EXPOSE 3210/tcp

ENTRYPOINT ["node"]
CMD ["/app/startServer.js"]
